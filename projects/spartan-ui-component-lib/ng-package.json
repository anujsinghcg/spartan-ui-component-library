{
  "$schema": "../../node_modules/ng-packagr/ng-package.schema.json",
  "dest": "../../dist/spartan-ui-component-lib",
  "lib": {
    "entryFile": "src/public-api.ts",
    "cssUrl": "inline"
  },
  "assets": [
    {
      "glob": "**/*.css",
      "input": "dist",
      "output": "/"
    },
    {
      "glob": "tailwind-preset.cjs",
      "input": ".",
      "output": "/"
    }
  ]
}